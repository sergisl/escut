# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Virtual environment ────────────────────────────────────────────────────────
.venv/
.venv.backup/
venv/
env/

# ── Build / packaging artefacts ───────────────────────────────────────────────
*.egg-info/
dist/
build/
*.egg

# ── Jupyter notebook checkpoints ──────────────────────────────────────────────
.ipynb_checkpoints/

# ── Generated output files (large binaries / reproducible from notebooks) ─────
*.npz
*.pdf
*.png
!assets/*.png

# ── macOS metadata ────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Test / coverage artefacts ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Environment files ─────────────────────────────────────────────────────────
.env

# ── Research material: not part of the escut release ──────────────────────────
# The paper, correspondence, derivations and the exploratory pipeline that
# produced them all live in this working tree but must never be published.
assets/drafts/
main/archive/
main/symbiotic.py
scripts/
notes/
QUICK_REFERENCE.py
START_HERE.txt
_cleanup_plotting.py
_verify_final.py
fix_notebooks.py
verify_solver.py

# Ship the cached sweeps for the worked example: without them the phase
# diagrams take nearly two hours to regenerate from scratch.
!examples/**/*.npz

# Local-only material: correspondence, seminars, superseded drafts, stale sweeps.
# Never part of the public release.
archive/

# Paper-internal: demonstrates main/symbiotic.py, which is not part of the
# released package. examples/ covers the symbiosis via the public API instead.

# Paper-internal working directory: figure generators, sweeps and caches for the
# symbiosis paper. The public notebooks now live in examples/, so nothing here is
# released. A single rule rather than per-file ones, which broke whenever a file
# was added or the directory was reorganised.
notebooks/
